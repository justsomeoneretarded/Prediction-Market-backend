{
  "name": "tinbit-api",
  "version": "0.1.0",
  "private": true,
  "description": "Tinbit prediction market API (NestJS + Prisma + PostgreSQL)",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "sh scripts/dev.sh",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "node --env-file-if-exists=.env -r ts-node/register/transpile-only prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand test/unit",
    "test:int": "jest --runInBand test/integration",
    "scenario": "node --env-file-if-exists=.env -r ts-node/register/transpile-only scripts/critical-scenario.ts"
  },
  "prisma": {
    "seed": "node --env-file-if-exists=.env -r ts-node/register/transpile-only prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.9",
    "@nestjs/core": "^11.2.9",
    "@nestjs/platform-express": "^11.2.9",
    "@nestjs/platform-socket.io": "^11.2.9",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/websockets": "^11.2.9",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/client": "6.19.3",
    "cookie-parser": "^1.4.7",
    "decimal.js": "^10.6.0",
    "helmet": "^8.3.0",
    "otplib": "^12.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.9",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "jest": "^29.7.0",
    "prisma": "6.19.3",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "prisma",
      "@prisma/client",
      "@prisma/engines",
      "@nestjs/core"
    ]
  }
}
