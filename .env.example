# ── Core ──
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tinbit?schema=public
# Origin(s) of the web app, comma separated (CORS + websocket).
WEB_ORIGIN=http://localhost:3000

# ── Sessions ──
SESSION_TTL_HOURS=168
# Set true behind HTTPS in production.
COOKIE_SECURE=false

# ── Platform rules ──
# Virtual birr every new account receives (no real-world value).
SIGNUP_BONUS=10000
MIN_AGE=18
# ISO-3166 alpha-2 codes that may not register (jurisdictional access control).
BLOCKED_COUNTRIES=
# Admin/resolver/reviewer accounts must pass TOTP 2FA before privileged actions.
ADMIN_REQUIRE_2FA=false

# ── Demo mode ──
# Enables the simulated clock (time travel) and mock data controls in the admin panel.
DEMO_MODE=true

# ── Payments (real money is DISABLED; only the simulated provider exists) ──
PAYMENTS_PROVIDER=simulated
WITHDRAWAL_APPROVAL_THRESHOLD=0

# ── Football data ──
# mock | api-football     (mock = clearly labelled demonstration fixtures)
FOOTBALL_PROVIDER=mock
API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
